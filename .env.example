# PostgreSQL connection string. URL-encode special characters in the password.
DATABASE_URL="postgresql://joblearner:change_me@localhost:5432/job_learner"
# Generate a long random value, e.g. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Server-side only Gemini key. Never prefix this value with NEXT_PUBLIC_.
GEMINI_API_KEY=
